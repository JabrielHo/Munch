# These are written automatically the first time you run `npx convex dev`.
# Copy this file to .env.local only if you want to set them by hand.
#
# The URL your React app talks to (Convex deployment, *.convex.cloud):
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
#
# Which Convex deployment the CLI targets:
# CONVEX_DEPLOYMENT=dev:your-deployment-name
#
# Optional: renders an "Add Munch to your group" button on the landing page:
# VITE_TELEGRAM_BOT_LINK=https://t.me/YourMunchBot
